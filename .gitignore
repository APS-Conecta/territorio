# deps
node_modules/
# vendor/ is built per-machine EXCEPT aps-common's src/, which is committed:
# release tarballs are `git archive` of the tracked tree, so the shared code
# rides the tarball the way js/ does. Composer's installed extras under
# vendor/aps (the package's own composer.json, tests/, stub/) stay ignored —
# src/ is the artifact aps-sync reproduces.
/vendor/*
!/vendor/aps/
/vendor/aps/*
!/vendor/aps/common/
/vendor/aps/common/*
!/vendor/aps/common/src/

# build — js/ is built, not committed: the release workflow builds it before packing the
# tarball (pack-app refuses a committed bundle), and a clone needs `npm ci && npm run
# build` before the app works. The .LICENSE.txt files terser extracts land in js/ with
# the bundle — ignored here, regenerated by every build — and they carry the third-party
# licence notices that travel inside the distribution. Sourcemaps are not shipped either.
/js/
*.js.map
dist/
build/
coverage/
.phpunit.cache/

.env
.env.*
!.env.example

*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.DS_Store
.cache/
.vite/

# Screenshots from tools/browser-check.py — evidence for a person, not source.
tools/.browser-check/

# tools/browser-check.py imports tools/ramp-check.py, so Python caches it here.
__pycache__/

# openapi tooling (scripts/openapi.sh) — scoped: the tracked tools/ scripts
# (ramp-check.py, notices.sh, browser-check.py) stay tracked.
/tools/composer.phar
/tools/openapi/
graphify-out/
