<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>territorio</id>
    <name>Territorio</name>
    <summary>Mapa territorial de un CESFAM</summary>
    <description><![CDATA[
El territorio que atiende un CESFAM, en un mapa: unidades vecinales oficiales,
sectores propios, y los lugares de la comuna — colegios, plazas, farmacias,
organizaciones sociales.

No contiene información de pacientes.
    ]]></description>
    <version>0.77.2</version>
    <licence>AGPL-3.0-or-later</licence>
    <author mail="d.espinoza.charrier@gmail.com">Daniel Espinoza</author>
    <namespace>Territorio</namespace>
    <documentation>
        <admin>https://github.com/APS-Conecta/territorio/blob/main/README.md#configuration</admin>
        <developer>https://github.com/APS-Conecta/territorio/blob/main/README.md#working-on-it</developer>
    </documentation>
    <category>tools</category>
    <dependencies>
        <php min-version="8.1"/>
        <lib>zip</lib>
        <nextcloud min-version="34" max-version="34"/>
    </dependencies>
    <navigations>
        <navigation>
            <name>Territorio</name>
            <route>territorio.page.index</route>
        </navigation>
    </navigations>
    <commands>
        <command>OCA\Territorio\Command\Import</command>
    </commands>
    <settings>
        <admin>OCA\Territorio\Settings\AdminSettings</admin>
        <admin-section>OCA\Territorio\Settings\AdminSection</admin-section>
    </settings>
    <!--
      Seeding lives here, not in a migration's postSchemaChange, because that
      hook is skipped when an app's schema is applied on a first install — the
      one case where the seed matters most. Registered for both events; the step
      is guarded and idempotent.
    -->
    <repair-steps>
        <install>
            <step>OCA\Territorio\Migration\EnsureSeedData</step>
        </install>
        <post-migration>
            <step>OCA\Territorio\Migration\EnsureSeedData</step>
        </post-migration>
    </repair-steps>
</info>
